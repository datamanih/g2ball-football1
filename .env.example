# Copy to .env (or enter in your host's Environment Variables screen). Never commit .env.
PORT=8787
TRUST_PROXY=1
DATA_DIR=./data

# Your Apify API token (Apify Console -> Settings -> API & Integrations).
# Used on the server only when a signed-in visitor adds a brand-new FA Full-Time division,
# or when a followed division is refreshed after 6 hours.
APIFY_TOKEN=

# Optional: your G2Ball Full-Time actor id or "username~g2ball-fulltime-feed".
# Leave blank to find it automatically on your Apify account.
APIFY_ACTOR=

# Optional: your own FullTime API instance (tried before Apify if set).
FULLTIME_API_URL=

# Optional limits (protect your Apify credit):
DIVISION_TTL_HOURS=6
NEW_DIVISIONS_PER_DAY=20
REFRESH_RUNS_PER_DAY=40
SIGNUPS_PER_HOUR=20
